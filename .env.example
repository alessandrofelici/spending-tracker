# Required (unless you always run with --no-llm).
# OpenRouter API key, used to call Jev: https://openrouter.ai/keys
OPENROUTER_KEY=sk-or-v1-your-key-here

# Optional: Jev model on OpenRouter. Pin a dated version for reproducible results,
# or use the alias that always tracks the newest release.
JEV_MODEL=typesafe/jev-1.13
# JEV_MODEL=typesafe/jev-1.13-20260917
# JEV_MODEL=~typesafe/jev-latest

# Optional: minimum confidence (0-1) to accept Jev's category.
# Anything lower is left as "Other" for `spend review`.
# Higher = fewer wrong guesses, more to review. Lower = less review, more mistakes.
JEV_MIN_CONFIDENCE=0.6

# Optional: use a different database file (e.g. for testing, or to share
# one database between git worktrees). Default: data/spending.db
# SPENDING_DB=/path/to/spending.db

# Optional: use a different categories file (e.g. to test adding a category
# without touching your own). Default: categories.toml
# SPENDING_CATEGORIES=/path/to/categories.toml
